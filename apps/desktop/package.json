{
  "name": "@fireeyeaud/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "火眼审计助手 Electron 壳（主进程 + preload）",
  "author": "fireeyeaud",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.fireeyeaud.app",
    "productName": "火眼审计助手",
    "files": [
      "src/**/*",
      "loading.html"
    ],
    "extraResources": [
      {
        "from": "../../services/agent/dist/fireeyeaud-agent.exe",
        "to": "agent/fireeyeaud-agent.exe"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  }
}
