{
  "name": "@fireeyeaud/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "火眼审计助手 Electron 壳（主进程 + preload）",
  "license": "GPL-3.0-only",
  "author": "fireeyeaud",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.fireeyeaud.app",
    "productName": "火眼审计助手",
    "electronVersion": "44.7.0",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../../services/agent/dist/fireeyeaud-agent.exe",
        "to": "agent/fireeyeaud-agent.exe"
      },
      {
        "from": "../renderer/dist",
        "to": "renderer"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.0"
  }
}
