{
  "name": "fireeyeaud",
  "private": true,
  "version": "0.1.0",
  "description": "火眼审计助手 — 纯本地财务/会计审计桌面助手",
  "license": "GPL-3.0-only",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agent:dev": "uv run --project services/agent uvicorn fireeyeaud_agent.main:app --host 127.0.0.1 --port 8765 --reload",
    "agent:test": "uv run --project services/agent pytest services/agent/tests",
    "agent:lint": "uv run --project services/agent ruff check services/agent",
    "renderer:dev": "npm run dev -w @fireeyeaud/renderer",
    "renderer:build": "npm run build -w @fireeyeaud/renderer",
    "renderer:typecheck": "npm run typecheck -w @fireeyeaud/renderer",
    "desktop:dev": "npm run dev",
    "desktop:test": "npm run test -w @fireeyeaud/desktop",
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"npm run renderer:dev\" \"npm run dev:electron\"",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env FIREEYEAUD_DEV_SERVER_URL=http://127.0.0.1:5173 electron apps/desktop"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
